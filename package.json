{
  "name": "ai-prompt-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first bilingual tag editor for English image prompts, with NovelAI weights and local collections.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "catalog:sort-index": "node scripts/build-sort-index.cjs",
    "predev": "node scripts/build-sort-index.cjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/generate-notices.mjs && node scripts/build-sort-index.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
